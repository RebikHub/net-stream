{
  "name": "net-stream-electron",
  "productName": "net-stream-electron",
  "version": "1.0.0",
  "description": "Stream-net electron app",
  "type": "module",
  "main": "src/index.mjs",
  "scripts": {
    "start": "npm run build:client && npm run copy:client && electron-forge start -- --no-sandbox",
    "build": "npm run build:client && npm run copy:client",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "publish": "electron-forge publish",
    "dist": "npm run build && electron-forge make",
    "postinstall": "cd client && npm install",
    "fix:sandbox": "sudo chown root:root node_modules/electron/dist/chrome-sandbox && sudo chmod 4755 node_modules/electron/dist/chrome-sandbox",
    "dev:server": "node --watch --no-warnings server/index.js",
    "standard": "npx standard",
    "fix": "npx standard --fix",
    "build:client": "cd client && npm run build",
    "copy:client": "npx rimraf src/assets/client/index.js src/assets/client/index.css && npx cpy client/dist/index.js client/dist/index.css src/assets/client/ --flat"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8",
    "@electron-forge/maker-deb": "^8",
    "@electron-forge/maker-rpm": "^8",
    "@electron-forge/maker-squirrel": "^8",
    "@electron-forge/maker-zip": "^8",
    "@electron-forge/plugin-auto-unpack-natives": "^8",
    "@electron-forge/plugin-fuses": "^8",
    "@electron-forge/publisher-github": "^8",
    "@electron/fuses": "^2",
    "electron": "^44.7.0",
    "standard": "^17",
    "rimraf": "^6.1.3",
    "cpy-cli": "^7.0.0"
  },
  "keywords": [],
  "author": {
    "name": "RebikHub",
    "email": "rebikovlk@mail.ru"
  },
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "electron-squirrel-startup": "^1",
    "express": "^5.3.0",
    "m3u8-parser": "^7",
    "parse-torrent": "^11.0.24",
    "torrent-search-api": "^2.1.4",
    "vlc-command": "^1",
    "webtorrent": "^3.0.21"
  },
  "permissions": [
    "audio",
    "video"
  ]
}